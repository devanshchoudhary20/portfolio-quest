{
  "name": "portfolio-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/check-content.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender-resume.tsx",
    "postbuild": "tsx scripts/check-content.ts --dist",
    "check:content": "tsx scripts/check-content.ts",
    "test": "npm run check:fixtures && vitest run",
    "lint": "eslint .",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "smoke": "playwright test",
    "art:placeholders": "tsx scripts/make-battle-placeholders.ts",
    "map": "tsx scripts/build-map.ts",
    "map:all": "for f in maps-src/*.map; do tsx scripts/build-map.ts $f || exit 1; done"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3",
    "@netlify/functions": "6.0.2",
    "grid-engine": "2.52.1",
    "phaser": "4.2.1",
    "preact": "11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "grid-engine": {
      "phaser": "$phaser"
    }
  }
}
